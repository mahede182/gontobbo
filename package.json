{
  "name": "@gontobbo/gontobbo",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:mobile": "yarn workspace @gontobbo/mobile dev",
    "dev:backend": "yarn workspace @gontobbo/backend dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "android": "yarn workspace @gontobbo/mobile android",
    "ios": "yarn workspace @gontobbo/mobile ios",
    "format": "yarn workspace @gontobbo/mobile format",
    "prepare": "husky"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "prettier": "^3.8.1",
    "turbo": "^2.4.4",
    "typescript": "^5.4.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.1.0"
}
