# Server Configuration
PORT=4000
NODE_ENV=development

# Database Infrastructure
DB_IMAGE=pgvector/pgvector:pg17
DB_CONTAINER=gontobbo_pg_container
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=gontobbo
DB_PORT=5432
DB_HOST=localhost

# Prisma Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gontobbo?schema=public

# PGAdmin Configuration
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@gontobbo.co
PGADMIN_PASSWORD=Admin@1234

# Security
JWT_SECRET=gontobbo-dev-jwt-secret-key
JWT_REFRESH_SECRET=gontobbo-dev-refresh-secret-key
JWT_EXPIRY=30m
JWT_REFRESH_EXPIRY=7d

# Integration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
APPLE_CLIENT_ID=your-apple-client-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id

# AI
GONTOBBO_AI=your-gemini-api-key

# Client
CORS_ORIGIN=*
