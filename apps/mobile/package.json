{
  "name": "@gontobbo/mobile",
  "version": "1.0.0",
  "main": "./index.js",
  "scripts": {
    "dev": "npx react-native start",
    "start": "npx react-native start",
    "prebuild": "npx expo prebuild",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest",
    "lint": "cd ../.. && npx eslint apps/mobile/",
    "format": "cd ../.. && prettier apps/mobile/ --write && npx eslint apps/mobile/ --fix",
    "clean": "rm -rf node_modules/.cache"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "**/*.{js,jsx}",
      "!**/coverage/**",
      "!**/node_modules/**",
      "!**/babel.config.js",
      "!**/jest.setup.js"
    ]
  },
  "dependencies": {
    "@gontobbo/shared": "*",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-google-signin/google-signin": "^12.2.1",
    "@react-native-masked-view/masked-view": "0.3.1",
    "@react-navigation/bottom-tabs": "^6.6.0",
    "@react-navigation/drawer": "^6.7.2",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/stack": "^6.4.0",
    "@reduxjs/toolkit": "^2.11.2",
    "@shopify/restyle": "^2.4.4",
    "@xstate/react": "^4.1.1",
    "expo": "~51.0.18",
    "expo-apple-authentication": "~6.4.2",
    "expo-auth-session": "~5.5.2",
    "expo-blur": "~13.0.2",
    "expo-font": "~12.0.9",
    "expo-linear-gradient": "~13.0.2",
    "expo-random": "~14.0.1",
    "expo-status-bar": "~1.12.1",
    "moti": "^0.29.0",
    "react": "18.2.0",
    "react-native": "0.74.3",
    "react-native-config": "^1.5.3",
    "react-native-date-ranges": "^2.5.0",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-keyboard-controller": "^1.20.7",
    "react-native-maps": "1.14.0",
    "react-native-otp-entry": "^1.7.3",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.1",
    "react-native-screens": "3.31.1",
    "react-native-toast-message": "^2.3.3",
    "react-redux": "^9.2.0",
    "xstate": "^5.14.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~18.2.45",
    "@types/react-test-renderer": "^18.3.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.57.0",
    "eslint-config-expo": "^7.1.2",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react-native": "^4.1.0",
    "i18next": "^23.11.5",
    "jest": "^29.7.0",
    "jest-expo": "^51.0.3",
    "prettier": "^3.3.3",
    "react-i18next": "^14.1.2",
    "react-native-calendars": "^1.1306.0",
    "react-native-dotenv": "^3.4.11",
    "react-test-renderer": "^18.3.1",
    "reactotron-react-native": "^5.1.18",
    "reactotron-react-native-mmkv": "^0.2.9",
    "reactotron-redux": "^3.2.1",
    "typescript": "^5.1.3"
  },
  "private": true
}
